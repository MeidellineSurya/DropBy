ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POSTGRES_HOST:5432/dropby
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379/0
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
QR_SIGNING_SECRET=replace-with-a-different-random-secret
FCM_CREDENTIALS_JSON_PATH=
CORS_ALLOWED_ORIGINS=https://REPLACE-WITH-YOUR-DASHBOARD-DOMAIN
